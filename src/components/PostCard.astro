---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import TagBadge from './TagBadge.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	showImage?: boolean;
}

const { post, showImage = true } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
---

<a
	href={`/blog/${post.id}/`}
	class="flat-card hover-lift p-6 group flex flex-col h-full"
>
	{
		showImage && heroImage && (
			<div class="thumb-tint mb-4 h-48 w-full rounded-lg">
				<img src={heroImage.src} alt="" class="size-full object-cover" loading="lazy" />
			</div>
		)
	}
	<h2 class="inline text-xl font-semibold mb-2 text-slate-800 group-hover:text-[var(--primary-main)] dark:text-zinc-100 dark:group-hover:text-primary-300 transition-colors">
		{title}
	</h2>
	<p class="text-sm text-slate-500 dark:text-zinc-400 mb-2">
		<FormattedDate date={pubDate} relative />
	</p>
	<p class="text-slate-500 dark:text-zinc-400 text-sm leading-relaxed line-clamp-3 mb-3">
		{description}
	</p>
	{
		tags.length > 0 && (
			<div class="flex flex-wrap gap-1.5">
				{tags.slice(0, 4).map((tag) => (
					<TagBadge tag={tag} />
				))}
				{tags.length > 4 && (
					<span class="text-xs text-slate-400 dark:text-zinc-500">+{tags.length - 4}</span>
				)}
			</div>
		)
	}
</a>
