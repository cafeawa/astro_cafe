---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import TagBadge from './TagBadge.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	showImage?: boolean;
}

const { post, showImage = true } = Astro.props;
const { title, description, pubDate, heroImage, tags } = post.data;
---

<a
	href={`/blog/${post.id}/`}
	class="flat-card p-6 group flex flex-col h-full"
>
	{
		showImage && heroImage && (
			<img
				src={heroImage.src}
				alt=""
				class="w-full h-48 object-cover mb-4"
				loading="lazy"
			/>
		)
	}
	<h2 class="underline-hover inline text-xl font-semibold mb-2 text-slate-800 dark:text-slate-100 group-hover:text-[var(--accent-text)] dark:group-hover:text-[var(--accent)] transition-colors">
		{title}
	</h2>
	<p class="text-sm text-slate-500 dark:text-slate-400 mb-2">
		<FormattedDate date={pubDate} />
	</p>
	<p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed line-clamp-3 mb-3">
		{description}
	</p>
	{
		tags.length > 0 && (
			<div class="flex flex-wrap gap-1.5">
				{tags.slice(0, 4).map((tag) => (
					<TagBadge tag={tag} />
				))}
				{tags.length > 4 && (
					<span class="text-xs text-slate-400 dark:text-slate-500">+{tags.length - 4}</span>
				)}
			</div>
		)
	}
</a>
