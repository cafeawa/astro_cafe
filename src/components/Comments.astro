---
import '@waline/client/style';
import { WALINE_SERVER_URL } from '../consts';

interface Props {
	serverURL?: string;
}

const { serverURL = WALINE_SERVER_URL } = Astro.props;
---

<section id="comments" class="relative mt-16 pt-8 border-t border-slate-200 dark:border-zinc-800" aria-label="文章评论">
	<div id="waline" data-server-url={serverURL}></div>
</section>

<style is:global>
	/* 隐藏昵称/邮箱/网址输入框 + 头像 */
	[data-waline] .wl-header { display: none !important; }
	[data-waline] .wl-user-avatar,
	[data-waline] .wl-card .wl-avatar,
	[data-waline] img[class*="avatar"] { display: none !important; }

	/* Waline 主题配色适配 — 冰蓝系 */
	[data-waline] {
		--waline-theme-color: var(--primary-500);
		--waline-active-color: var(--primary-300);
		--waline-bg-color: transparent;
		--waline-bg-color-light: #f8fafc;
	}

	/* 文章反应 — 正文左下角的小胶囊，接近 Telegram / Discord 的 reaction */
	[data-waline] .wl-reaction {
		position: absolute;
		left: 0;
		top: -3rem;
		z-index: 1;
		display: inline-flex;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 0 !important;
		background: transparent;
		box-shadow: none;
		overflow: visible;
	}
	[data-waline] .wl-reaction-title {
		display: none;
	}
	[data-waline] .wl-reaction-list {
		gap: 0.4rem;
		margin: 0;
		padding: 0;
	}
	[data-waline] .wl-reaction-item {
		position: relative;
		display: inline-flex;
		align-items: center;
		min-width: 0;
		padding: 0.22rem 0.5rem;
		border: 1px solid #cbd5e1;
		border-radius: 9999px !important;
		background: #ffffff;
		box-shadow: 0 1px 1.5px rgba(15, 23, 42, 0.05);
		outline: none;
		transition: border-color 0.15s ease, background-color 0.15s ease, box-shadow 0.15s ease;
	}
	[data-waline] .wl-reaction-item:hover,
	[data-waline] .wl-reaction-item.active,
	[data-waline] .wl-reaction-item:focus-visible {
		background: var(--primary-50);
	}
	[data-waline] .wl-reaction-item:focus-visible {
		border-color: var(--primary-400);
		box-shadow: 0 0 0 2px var(--primary-300);
	}
	[data-waline] .wl-reaction-img {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		width: auto;
		height: 1.35rem;
	}
	[data-waline] .wl-reaction-img img {
		display: none;
	}
	[data-waline] .wl-reaction-img::before {
		font-size: 1rem;
		line-height: 1;
	}
	[data-waline] .wl-reaction-item:nth-child(1) .wl-reaction-img::before { content: '❤️'; }
	[data-waline] .wl-reaction-item:nth-child(2) .wl-reaction-img::before { content: '🔥'; }
	[data-waline] .wl-reaction-item:nth-child(3) .wl-reaction-img::before { content: '👍'; }
	[data-waline] .wl-reaction-item:nth-child(4) .wl-reaction-img::before { content: '🎉'; }
	[data-waline] .wl-reaction-votes {
		position: static;
		min-width: 0.7rem;
		padding: 0;
		border: 0 !important;
		border-radius: 0;
		background: transparent !important;
		box-shadow: none !important;
		color: #64748b;
		font-size: 0.75rem;
		line-height: 1;
	}
	[data-waline] .wl-reaction-item.active .wl-reaction-votes {
		color: var(--primary-700) !important;
	}
	[data-waline] .wl-reaction-text {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		padding: 0;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	/* Waline 文本链接 — 下划线动画（按钮保持纯色反馈） */
	[data-waline] a {
		position: relative;
	}
	[data-waline] a::after {
		content: '';
		position: absolute;
		bottom: 0;
		left: 0;
		width: 0;
		height: 2px;
		background: var(--primary-500);
		transition: width 0.2s ease;
	}
	[data-waline] a:hover::after {
		width: 100%;
	}

	/* 提交按钮 — 圆角胶囊，冰蓝填充 */
	[data-waline] .wl-btn {
		background: var(--primary-500) !important;
		border: 1px solid transparent !important;
		border-radius: 9999px !important;
		color: #ffffff !important;
		font-weight: 600;
		transition: all 0.2s ease;
	}
	[data-waline] .wl-btn:hover {
		background: var(--primary-600) !important;
		box-shadow: 0 6px 16px rgba(62, 151, 199, 0.28);
	}

	/* 输入框 — 圆角冰蓝描边 */
	[data-waline] .wl-input,
	[data-waline] .wl-editor,
	[data-waline] textarea,
	[data-waline] .wl-panel {
		border-radius: 0.75rem !important;
	}
	[data-waline] .wl-input,
	[data-waline] .wl-editor {
		border-color: #e2e8f0 !important;
		background-color: transparent !important;
	}
	[data-waline] .wl-editor:focus {
		background-color: transparent !important;
	}
	[data-waline] .wl-editor:focus-within,
	[data-waline] .wl-input:focus {
		border-color: var(--primary-400) !important;
	}

	/* 表情选择弹层需要实色背景，避免内容透到评论列表上 */
	[data-waline] .wl-emoji-popup,
	[data-waline] .wl-emoji-preview {
		border-color: #e2e8f0 !important;
		background: #ffffff !important;
		box-shadow: 0 12px 28px rgba(15, 23, 42, 0.14);
	}

	/* 暗黑模式 */
	.dark [data-waline] .wl-btn {
		background: var(--primary-400) !important;
		color: #ffffff !important;
	}
	.dark [data-waline] .wl-btn:hover {
		background: var(--primary-300) !important;
	}
	.dark [data-waline] .wl-input,
	.dark [data-waline] .wl-editor {
		border-color: var(--surface-line-strong) !important;
		background-color: transparent !important;
		color: var(--text-strong) !important;
	}
	.dark [data-waline] .wl-reaction-item {
		border-color: var(--surface-line-strong);
		background: var(--surface-raised);
		box-shadow: 0 1px 1.5px rgba(0, 0, 0, 0.35);
	}
	.dark [data-waline] .wl-reaction-title {
		color: var(--color-zinc-300);
	}
	.dark [data-waline] .wl-reaction-item:hover,
	.dark [data-waline] .wl-reaction-item.active,
	.dark [data-waline] .wl-reaction-item:focus-visible {
		border-color: var(--primary-400);
		background: rgba(140, 201, 227, 0.1);
	}
	.dark [data-waline] .wl-reaction-votes {
		color: var(--color-zinc-400);
	}
	.dark [data-waline] .wl-emoji-popup,
	.dark [data-waline] .wl-emoji-preview {
		border-color: var(--surface-line-strong) !important;
		background: var(--surface-raised) !important;
		box-shadow: 0 14px 32px rgba(0, 0, 0, 0.45);
	}
	.dark [data-waline] .wl-editor:focus-within,
	.dark [data-waline] .wl-input:focus {
		border-color: var(--primary-400) !important;
	}
</style>

<script>
	import { init } from '@waline/client';

	const el = document.getElementById('waline');
	const serverURL = el?.dataset.serverUrl || '';
	const emptyReactionIcon = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///ywAAAAAAQABAAACAUwAOw==';

	init({
		el: '#waline',
		serverURL,
		comment: true,
		pageview: true,
		reaction: Array(4).fill(emptyReactionIcon),
		dark: 'html.dark',
		lang: 'zh-CN',
		locale: {
			reactionTitle: '文章反应',
			reaction0: '喜欢',
			reaction1: '火',
			reaction2: '赞',
			reaction3: '庆祝',
		},
		login: 'disable',
		meta: [],
		emoji: ['https://unpkg.com/@waline/emojis@1.2.0/bmoji'],
		imageUploader: false,
		pageSize: 10,
	});

	// Waline 使用可点击的 li 渲染文章反应；补上键盘操作和明确标签。
	document.querySelectorAll<HTMLElement>('.wl-reaction-item').forEach((item) => {
		const label = item.querySelector<HTMLImageElement>('img')?.alt || '文章反应';
		item.tabIndex = 0;
		item.setAttribute('role', 'button');
		item.setAttribute('aria-label', label);
		item.title = label;
		item.addEventListener('keydown', (event) => {
			if (event.key === 'Enter' || event.key === ' ') {
				event.preventDefault();
				item.click();
			}
		});
	});
</script>
