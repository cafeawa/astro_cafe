---
import { WALINE_SERVER_URL } from '../consts';

interface Props {
	serverURL?: string;
}

const { serverURL = WALINE_SERVER_URL } = Astro.props;
---

<div id="waline" data-server-url={serverURL} class="mt-16 pt-8 border-t border-[rgba(217,156,113,0.2)] dark:border-white/10"></div>

<style>
	/* 隐藏昵称/邮箱/网址输入框 */
	#waline .wl-header { display: none !important; }
</style>

<script>
	import { init } from '@waline/client';

	const el = document.getElementById('waline');
	const serverURL = el?.dataset.serverUrl || '';

	// DOM 就绪后移除 meta 输入区（兜底方案）
	const observer = new MutationObserver(() => {
		const header = document.querySelector('#waline .wl-header');
		if (header) {
			header.remove();
			observer.disconnect();
		}
	});
	observer.observe(document.body, { childList: true, subtree: true });

	init({
		el: '#waline',
		serverURL,
		dark: 'html.dark',
		lang: 'zh-CN',
		login: 'disable',
		emoji: [
			'https://unpkg.com/@waline/emojis@1.2.0/tieba',
			'https://unpkg.com/@waline/emojis@1.2.0/bmoji',
		],
		imageUploader: false,
		pageSize: 10,
	});
</script>
