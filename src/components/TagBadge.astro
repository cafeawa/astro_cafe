---
interface Props {
	tag: string;
	href?: string;
	size?: 'sm' | 'md';
}

const { tag, href, size = 'sm' } = Astro.props;
const sizeClass = size === 'md' ? 'px-3 py-1 text-sm' : 'px-2.5 py-0.5 text-xs';
const baseClass = `${sizeClass} rounded-full font-medium bg-primary-100 text-primary-700 dark:bg-primary-500/15 dark:text-primary-300 hover:bg-primary-200 dark:hover:bg-primary-500/25 transition-colors`;
---

{
	href ? (
		<a href={href} class={baseClass}>{tag}</a>
	) : (
		<span class={baseClass}>{tag}</span>
	)
}
