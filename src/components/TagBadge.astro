---
interface Props {
	tag: string;
	href?: string;
	size?: 'sm' | 'md';
}

const { tag, href, size = 'sm' } = Astro.props;
const sizeClass = size === 'md' ? 'px-3 py-1 text-sm' : 'px-2 py-0.5 text-xs';
const baseClass = `${sizeClass} font-medium bg-[var(--accent-light)] text-[var(--accent-text)] dark:bg-[rgba(255,214,186,0.15)] dark:text-[var(--accent)] hover:bg-[var(--accent-peach)] dark:hover:bg-[rgba(255,214,186,0.25)] transition-colors`;
---

{
	href ? (
		<a href={href} class={baseClass}>{tag}</a>
	) : (
		<span class={baseClass}>{tag}</span>
	)
}
