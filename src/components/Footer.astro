---
import { FOOTER } from '../consts';

const today = new Date();
---

<footer class="py-12 px-4 text-center text-sm text-slate-500 dark:text-zinc-400 border-t border-slate-200/60 dark:border-zinc-800/60 mt-16">
	<p>&copy; {today.getFullYear()} {FOOTER.copyright} All rights reserved.</p>
	{
		FOOTER.icp && (
			<p class="mt-2">
				<a
					href={FOOTER.icpUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-[var(--primary-main)] dark:hover:text-primary-300 transition-colors"
				>
					{FOOTER.icp}
				</a>
			</p>
		)
	}
	<p class="mt-4 text-xs text-slate-400 dark:text-zinc-500">
		Powered by <a href="https://astro.build" class="hover:text-slate-600 dark:hover:text-zinc-300">Astro</a>
		&middot;
		Styled with <a href="https://tailwindcss.com" class="hover:text-slate-600 dark:hover:text-zinc-300">Tailwind CSS</a>
	</p>
</footer>
