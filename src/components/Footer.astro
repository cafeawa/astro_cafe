---
import { FOOTER } from '../consts';

const today = new Date();
---

<footer class="py-12 px-4 text-center text-sm text-gray-500 dark:text-gray-400 border-t border-gray-200 dark:border-gray-700">
	<p>&copy; {today.getFullYear()} {FOOTER.copyright} All rights reserved.</p>
	{
		FOOTER.icp && (
			<p class="mt-2">
				<a
					href={FOOTER.icpUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="hover:text-gray-700 dark:hover:text-gray-200 transition-colors"
				>
					{FOOTER.icp}
				</a>
			</p>
		)
	}
	<p class="mt-4 text-xs text-gray-400 dark:text-gray-500">
		Powered by <a href="https://astro.build" class="hover:text-gray-600 dark:hover:text-gray-300">Astro</a>
		&middot;
		Styled with <a href="https://tailwindcss.com" class="hover:text-gray-600 dark:hover:text-gray-300">Tailwind CSS</a>
	</p>
</footer>
