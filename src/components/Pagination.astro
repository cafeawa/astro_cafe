---
interface Props {
	currentPage: number;
	totalPages: number;
	basePath?: string;
}

const { currentPage, totalPages, basePath = '/blog' } = Astro.props;

if (totalPages <= 1) return;

function pageUrl(page: number): string {
	if (page === 1) return basePath;
	return `${basePath}/page/${page}`;
}

const btnBase = 'px-4 py-2 text-sm font-medium transition-all rounded-full border';
const activeClass = `${btnBase} bg-primary/10 border-primary/30 text-[var(--primary-main)] dark:text-primary-300 font-semibold`;
const inactiveClass = `${btnBase} border-slate-200 bg-white/50 text-slate-600 hover:bg-primary/5 dark:border-zinc-800 dark:bg-zinc-900/50 dark:text-zinc-300 dark:hover:bg-primary/5`;
const disabledClass = `${btnBase} border-slate-100 dark:border-zinc-800/50 text-slate-300 dark:text-zinc-600 cursor-not-allowed`;
---

<nav class="flex justify-center items-center gap-2 mt-12" aria-label="Pagination">
	{
		currentPage > 1 ? (
			<a href={pageUrl(currentPage - 1)} class={inactiveClass}>← 上一页</a>
		) : (
			<span class={disabledClass}>← 上一页</span>
		)
	}

	{
		Array.from({ length: totalPages }, (_, i) => i + 1).map((page) =>
			page === currentPage ? (
				<span class={activeClass}>{page}</span>
			) : (
				<a href={pageUrl(page)} class={inactiveClass}>{page}</a>
			)
		)
	}

	{
		currentPage < totalPages ? (
			<a href={pageUrl(currentPage + 1)} class={inactiveClass}>下一页 →</a>
		) : (
			<span class={disabledClass}>下一页 →</span>
		)
	}
</nav>
