---
interface Props {
	currentPage: number;
	totalPages: number;
	basePath?: string;
}

const { currentPage, totalPages, basePath = '/blog' } = Astro.props;

if (totalPages <= 1) return;

function pageUrl(page: number): string {
	if (page === 1) return basePath;
	return `${basePath}/page/${page}`;
}
---

<nav class="flex justify-center items-center gap-2 mt-12" aria-label="Pagination">
	<!-- 上一页 -->
	{
		currentPage > 1 ? (
			<a
				href={pageUrl(currentPage - 1)}
				class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-sm"
			>
				← 上一页
			</a>
		) : (
			<span class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-300 dark:text-gray-600 text-sm cursor-not-allowed">
				← 上一页
			</span>
		)
	}

	<!-- 页码 -->
	{
		Array.from({ length: totalPages }, (_, i) => i + 1).map((page) => (
			page === currentPage ? (
				<span class="px-4 py-2 rounded-lg bg-blue-600 text-white text-sm font-medium">
					{page}
				</span>
			) : (
				<a
					href={pageUrl(page)}
					class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-sm"
				>
					{page}
				</a>
			)
		))
	}

	<!-- 下一页 -->
	{
		currentPage < totalPages ? (
			<a
				href={pageUrl(currentPage + 1)}
				class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors text-sm"
			>
				下一页 →
			</a>
		) : (
			<span class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-300 dark:text-gray-600 text-sm cursor-not-allowed">
				下一页 →
			</span>
		)
	}
</nav>
