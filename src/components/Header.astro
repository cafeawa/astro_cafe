---
import { SITE_TITLE, NAV_ITEMS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
---

<!-- 
  修改点：移除了纯色的 flat-nav，改用 bg-white/75 + backdrop-blur-lg
  保持了 border-b 和直角特性，实现“扁平毛玻璃”效果 
-->
<header class="sticky top-0 z-50 bg-white/75 dark:bg-[#1a1614]/75 backdrop-blur-lg border-b border-[rgba(217,156,113,0.2)] dark:border-white/10 transition-colors duration-300">
	<nav class="max-w-5xl mx-auto flex items-center justify-between px-4 h-16">
		
		<!-- Logo / 站点名 -->
		<a href="/" class="text-xl font-bold tracking-tight text-slate-800 dark:text-white hover:text-[var(--accent-text)] transition-colors">
			{SITE_TITLE}
		</a>

		<!-- 桌面端导航链接 (保持扁平化的底边悬停交互) -->
		<div class="hidden md:flex items-center gap-6">
			{NAV_ITEMS.map((item) => (
				<a 
					href={item.href} 
					class="relative text-sm font-medium text-slate-600 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-colors group py-1"
				>
					{item.label}
					<span class="absolute bottom-0 left-0 w-0 h-[2px] bg-[var(--accent-text)] transition-all duration-200 group-hover:w-full"></span>
				</a>
			))}
		</div>

		<!-- 右侧：主题切换 + 移动端菜单按钮 -->
		<div class="flex items-center gap-2">
			<ThemeToggle />
			<!-- 移动端菜单按钮 -->
			<button
				id="mobile-menu-btn"
				class="md:hidden p-2 text-slate-600 hover:text-[var(--accent-text)] dark:text-slate-300 hover:bg-[var(--accent-light)] dark:hover:bg-[#2a2420] transition-colors border border-transparent hover:border-[rgba(217,156,113,0.2)]"
				aria-label="Toggle menu"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
			</button>
		</div>
	</nav>

	<!-- 移动端菜单：同样应用半透明玻璃效果，保持一致性 -->
	<div id="mobile-menu" class="hidden md:hidden bg-white/85 dark:bg-[#1a1614]/85 backdrop-blur-lg border-t border-[rgba(217,156,113,0.2)] dark:border-white/10">
		<div class="px-4 py-3 flex flex-col gap-1">
			{NAV_ITEMS.map((item) => (
				<a 
					href={item.href} 
					class="block px-4 py-2.5 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-[var(--accent-light)] dark:text-slate-300 dark:hover:text-white dark:hover:bg-[#2a2420] transition-colors border border-transparent hover:border-[rgba(217,156,113,0.2)]"
				>
					{item.label}
				</a>
			))}
		</div>
	</div>
</header>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const menu = document.getElementById('mobile-menu');
	btn?.addEventListener('click', () => {
		menu?.classList.toggle('hidden');
	});
</script>