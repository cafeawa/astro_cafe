---
import { SITE_TITLE, NAV_ITEMS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
	href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<!-- 毛玻璃固定顶栏，导航为圆角胶囊组（借鉴 Hikarinagi） -->
<header class="fixed inset-x-0 top-0 z-50">
	<div
		class="absolute inset-0 border-b border-slate-200/60 backdrop-blur-xl backdrop-saturate-[1.8] bg-white/72 transition-colors dark:border-zinc-800/60 dark:bg-zinc-950/68"
		aria-hidden="true"
	></div>
	<nav class="relative mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
		<div class="flex min-w-0 items-center gap-6">
			<!-- Logo / 站点名 -->
			<a href="/" class="shrink-0 text-xl font-bold tracking-tight text-slate-800 hover:text-[var(--primary-main)] transition-colors dark:text-zinc-100">
				{SITE_TITLE}
			</a>

			<!-- 桌面端导航：圆角胶囊组 -->
			<div class="hidden md:flex items-center gap-1 rounded-full border border-slate-200/55 bg-white/42 p-1 shadow-[0_1px_8px_rgba(15,23,42,0.045)] dark:border-zinc-800/60 dark:bg-zinc-950/38 dark:shadow-[0_1px_8px_rgba(0,0,0,0.18)]">
				{NAV_ITEMS.map((item) => (
					<a
						href={item.href}
						class={`inline-flex h-9 items-center gap-1.5 rounded-full px-3 text-sm font-medium transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-[var(--primary-main)]/35 ${
							isActive(item.href)
								? 'bg-primary/10 text-[var(--primary-main)] shadow-[inset_0_0_0_1px_rgba(62,151,199,0.18),0_1px_6px_rgba(62,151,199,0.12)] dark:text-primary-300'
								: 'text-slate-600 hover:bg-primary/5 hover:text-[var(--primary-main)] dark:text-zinc-300 dark:hover:bg-primary/5 dark:hover:text-primary-300'
						}`}
					>
						{item.label}
					</a>
				))}
			</div>
		</div>

		<div class="flex shrink-0 items-center gap-2">
			<!-- 搜索 -->
			<a href="/search" aria-label="搜索" class="grid size-9 place-items-center rounded-full text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-800 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100">
				<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
			</a>

			<ThemeToggle />

			<!-- 移动端菜单按钮 -->
			<button
				id="mobile-menu-btn"
				class="md:hidden grid size-9 place-items-center rounded-full text-slate-600 hover:bg-slate-100 dark:text-zinc-300 dark:hover:bg-zinc-800 transition-colors"
				aria-label="Toggle menu"
			>
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="3" y1="6" x2="21" y2="6"></line>
					<line x1="3" y1="12" x2="21" y2="12"></line>
					<line x1="3" y1="18" x2="21" y2="18"></line>
				</svg>
			</button>
		</div>
	</nav>

	<!-- 移动端菜单 -->
	<div id="mobile-menu" class="hidden md:hidden border-t border-slate-200/60 bg-white/85 backdrop-blur-xl dark:border-zinc-800/60 dark:bg-zinc-950/85">
		<div class="px-4 py-3 flex flex-col gap-1">
			{NAV_ITEMS.map((item) => (
				<a
					href={item.href}
					class={`block rounded-lg px-4 py-2.5 text-sm font-medium transition-colors ${
						isActive(item.href)
							? 'bg-primary/10 text-[var(--primary-main)] dark:text-primary-300'
							: 'text-slate-600 hover:bg-slate-100 dark:text-zinc-300 dark:hover:bg-zinc-800'
					}`}
				>
					{item.label}
				</a>
			))}
		</div>
	</div>
</header>

<script>
	const btn = document.getElementById('mobile-menu-btn');
	const menu = document.getElementById('mobile-menu');
	btn?.addEventListener('click', () => {
		menu?.classList.toggle('hidden');
	});
</script>
