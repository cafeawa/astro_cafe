---
// 文章目录组件 — 客户端 JS 自动提取标题并生成锚点目录
---

<nav id="toc" class="hidden lg:block sticky top-24">
	<div class="text-sm font-semibold text-slate-500 dark:text-zinc-400 uppercase tracking-wide mb-3">目录</div>
	<ul id="toc-list" class="space-y-1.5 text-sm border-l-2 border-slate-200 dark:border-zinc-800">
		<!-- JS 动态生成 -->
	</ul>
</nav>

<script>
	function buildTOC() {
		const prose = document.querySelector('.prose');
		if (!prose) return;

		const headings = prose.querySelectorAll('h2, h3');
		if (headings.length < 2) {
			document.getElementById('toc')?.remove();
			return;
		}

		const list = document.getElementById('toc-list');
		if (!list) return;

		headings.forEach((heading) => {
			// 给标题加 id 以便锚点跳转
			const id = heading.textContent?.trim().toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9一-龥-]/g, '') || '';
			heading.id = id;

			const li = document.createElement('li');
			const a = document.createElement('a');
			a.href = `#${id}`;
			a.textContent = heading.textContent;
			a.className = heading.tagName === 'H3'
				? 'block pl-4 text-slate-500 dark:text-zinc-400 hover:text-[var(--primary-main)] dark:hover:text-primary-300 transition-colors'
				: 'block text-slate-700 dark:text-zinc-300 hover:text-[var(--primary-main)] dark:hover:text-primary-300 transition-colors font-medium';
			li.appendChild(a);
			list.appendChild(li);
		});

		document.getElementById('toc')?.classList.remove('hidden');
	}

	buildTOC();
</script>
