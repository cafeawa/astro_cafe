---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}

interface Props {
	headings: Heading[];
}

const { headings } = Astro.props;
---

<nav
	id="toc"
	aria-label="文章目录"
	class="sticky top-24 max-h-[calc(100vh-7rem)] overflow-y-auto pr-2"
>
	<div class="mb-3 text-sm font-semibold uppercase tracking-wide text-slate-500 dark:text-zinc-400">
		目录
	</div>
	<ul class="space-y-1 text-sm border-l-2 border-slate-200 dark:border-zinc-800">
		{
			headings.map((heading) => (
				<li>
					<a
						href={`#${heading.slug}`}
						data-toc-link
						class:list={[
							'toc-link block -ml-0.5 border-l-2 border-transparent py-0.5 transition-colors',
							heading.depth === 3
								? 'pl-6 text-slate-500 dark:text-zinc-400'
								: 'pl-3 font-medium text-slate-700 dark:text-zinc-300',
						]}
					>
						{heading.text}
					</a>
				</li>
			))
		}
	</ul>
</nav>

<script>
	const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
	const sections = links
		.map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
		.filter((section): section is HTMLElement => section !== null);

	let ticking = false;

	function updateActiveHeading() {
		const anchorOffset = 112;
		let activeSection = sections[0];

		for (const section of sections) {
			if (section.getBoundingClientRect().top <= anchorOffset) activeSection = section;
			else break;
		}

		links.forEach((link) => {
			const isActive = activeSection ? link.hash === `#${activeSection.id}` : false;
			link.classList.toggle('is-active', isActive);
			if (isActive) link.setAttribute('aria-current', 'location');
			else link.removeAttribute('aria-current');
		});

		ticking = false;
	}

	function requestActiveHeadingUpdate() {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(updateActiveHeading);
	}

	updateActiveHeading();
	document.addEventListener('scroll', requestActiveHeadingUpdate, { passive: true });
</script>

<style>
	#toc {
		scrollbar-width: thin;
		scrollbar-color: #cbd5e1 transparent;
		scrollbar-gutter: stable;
	}

	#toc::-webkit-scrollbar {
		width: 6px;
	}

	#toc::-webkit-scrollbar-button {
		display: none;
	}

	#toc::-webkit-scrollbar-track {
		background: transparent;
	}

	#toc::-webkit-scrollbar-thumb {
		border-radius: 9999px;
		background: #cbd5e1;
	}

	:global(.dark) #toc {
		scrollbar-color: var(--surface-line-strong) transparent;
	}

	:global(.dark) #toc::-webkit-scrollbar-thumb {
		background: var(--surface-line-strong);
	}

	.toc-link:hover,
	.toc-link.is-active {
		border-left-color: var(--primary-main);
		color: var(--primary-700);
	}

	:global(.dark) .toc-link:hover,
	:global(.dark) .toc-link.is-active {
		color: var(--primary-300);
	}
</style>
