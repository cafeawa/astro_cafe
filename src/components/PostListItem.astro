---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { SITE_AUTHOR } from '../consts';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const avatarInitial = SITE_AUTHOR.charAt(0).toUpperCase();
---

<a href={`/blog/${post.id}/`} class="flat-card hover-lift p-4 flex items-start gap-4 group">
	{
		post.data.heroImage ? (
			<div class="thumb-tint h-24 w-36 shrink-0 rounded-lg">
				<img
					src={post.data.heroImage.src}
					alt=""
					class="size-full object-cover"
					loading="lazy"
				/>
			</div>
		) : (
			<div class="h-24 w-36 shrink-0 rounded-lg bg-gradient-to-br from-primary-100 to-primary-300 dark:from-primary-500/20 dark:to-primary-300/20 flex items-center justify-center">
				<span class="text-2xl font-bold text-[var(--primary-700)] dark:text-primary-200">{avatarInitial}</span>
			</div>
		)
	}
	<div class="min-w-0 flex-1">
		<div class="mb-1.5 flex items-center justify-between gap-2 text-sm text-slate-500 dark:text-zinc-400">
			<div class="flex items-center gap-2">
				<span class="tabular-nums">
					<FormattedDate date={post.data.pubDate} relative />
				</span>
				{
					post.data.tags.length > 0 && (
						<span class="flex items-center gap-1.5">
							{post.data.tags.slice(0, 2).map((tag) => (
								<span class="rounded-full bg-primary-50 px-2 py-px text-xs font-medium text-primary-700 dark:bg-primary-900/35 dark:text-primary-300">
									{tag}
								</span>
							))}
						</span>
					)
				}
			</div>
			<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-4 shrink-0 text-slate-300 transition-transform group-hover:translate-x-0.5 group-hover:text-[var(--primary-main)] dark:text-zinc-600 dark:group-hover:text-primary-300">
				<path d="m9 18 6-6-6-6" />
			</svg>
		</div>
		<h3 class="text-lg font-semibold text-slate-800 dark:text-zinc-100 group-hover:text-[var(--primary-main)] dark:group-hover:text-primary-300 transition-colors line-clamp-1">
			{post.data.title}
		</h3>
		<p class="text-sm text-slate-500 dark:text-zinc-400 line-clamp-2 mt-1">
			{post.data.description}
		</p>
	</div>
</a>
