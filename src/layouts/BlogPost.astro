---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagBadge from '../components/TagBadge.astro';
import TableOfContents from '../components/TableOfContents.astro';
import Comments from '../components/Comments.astro';
import { SITE_TITLE } from '../consts';

interface Heading {
	depth: number;
	slug: string;
	text: string;
}

type Props = CollectionEntry<'blog'>['data'] & {
	headings?: Heading[];
};

const { title, description, pubDate, updatedDate, heroImage, tags, headings = [] } = Astro.props;
const tocHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<BaseLayout title={`${title} - ${SITE_TITLE}`} description={description} image={heroImage}>
	<main class="max-w-6xl mx-auto px-4 py-12">
		<div class="flex gap-12">
			<!-- 正文区域 -->
			<article class="flex-1 min-w-0">
				<!-- 封面图 -->
				{
					heroImage && (
						<div class="post-cover mb-8">
							<Image
								width={1020}
								height={510}
								src={heroImage}
								alt=""
								class="h-full w-full object-cover"
							/>
						</div>
					)
				}

				<!-- 文章头部 -->
				<header class="mb-10 text-center">
					<h1 class="text-4xl font-bold mb-4 leading-tight text-slate-800 dark:text-zinc-100">{title}</h1>
					<div class="text-slate-500 dark:text-zinc-400 mb-4">
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="ml-2 text-sm italic">
									· 更新于 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</div>
					<!-- 标签 -->
					{
						tags && tags.length > 0 && (
							<div class="flex flex-wrap justify-center gap-1.5">
								{tags.map((tag) => (
									<TagBadge tag={tag} href={`/tags/${tag}/`} size="md" />
								))}
							</div>
						)
					}
				</header>

				<!-- 文章正文 -->
				<div class="prose">
					<slot />
				</div>
			</article>

			<!-- 侧栏：目录 -->
			{
				tocHeadings.length >= 2 && (
					<aside class="hidden lg:block w-64 flex-shrink-0">
						<TableOfContents headings={tocHeadings} />
					</aside>
				)
			}
		</div>

		<!-- 评论区 -->
		<Comments />
	</main>
</BaseLayout>
