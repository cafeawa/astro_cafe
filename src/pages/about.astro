---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';

const friends: { name: string; url: string; description: string }[] = [
	// { name: '示例博客', url: 'https://example.com', description: '这是一个示例' },
];
---

<BaseLayout title={`关于 - ${SITE_TITLE}`} description="关于我">
	<main class="max-w-3xl mx-auto px-4 py-16">
		<h1 class="text-4xl font-bold mb-8 text-center">关于我</h1>

		<div class="prose">
			<p>
				你好！我是 cafeawa，一个热爱技术和生活的开发者。
			</p>
			<p>
				这个博客用来记录我在编程、技术探索和日常生活中的所思所想。
				内容涵盖前端开发、后端架构、工具配置以及各种有趣的技术话题。
			</p>
			<p>
				如果你对文章内容有任何想法或建议，欢迎在评论区留言交流 👋
			</p>

			<hr />

			<h2>关于本站</h2>
			<ul>
				<li>使用 <a href="https://astro.build">Astro</a> 构建</li>
				<li>样式基于 <a href="https://tailwindcss.com">Tailwind CSS</a></li>
				<li>评论系统使用 <a href="https://waline.js.org">Waline</a></li>
				<li>托管在自己的本地服务器上</li>
			</ul>

			<hr />

			<h2>友情链接</h2>
			{
				friends.length === 0 ? (
					<div class="text-center py-8">
						<p class="text-slate-500 dark:text-zinc-400 mb-2">还没有友链～</p>
						<p class="text-slate-400 dark:text-zinc-500 text-sm">想要交换友链？欢迎在评论区留言 👋</p>
					</div>
				) : (
					<div class="not-prose my-6 grid gap-4 sm:grid-cols-2">
						{friends.map((friend) => (
							<a
								href={friend.url}
								target="_blank"
								rel="noopener noreferrer"
								class="flat-card hover-lift p-5 group"
							>
								<div class="font-semibold text-slate-800 dark:text-zinc-100 mb-1 group-hover:text-[var(--primary-main)] dark:group-hover:text-primary-300 transition-colors">{friend.name}</div>
								<div class="text-sm text-slate-500 dark:text-zinc-400">{friend.description}</div>
							</a>
						))}
					</div>
				)
			}
		</div>
	</main>
</BaseLayout>
