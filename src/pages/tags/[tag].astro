---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag } from '../../utils/posts';
import { SITE_TITLE } from '../../consts';
import PostCard from '../../components/PostCard.astro';

export async function getStaticPaths() {
	const tags = await getAllTags();
	return tags.map(({ name }) => ({
		params: { tag: name },
	}));
}

const { tag } = Astro.params;
const posts = await getPostsByTag(tag!);
---

<BaseLayout title={`${tag} - 标签 - ${SITE_TITLE}`} description={`标签「${tag}」下的所有文章`}>
	<main class="max-w-5xl mx-auto px-4 py-12">
		<h1 class="text-4xl font-bold mb-4 text-center text-slate-800 dark:text-slate-100">
			标签：<span class="text-[var(--accent-text)] dark:text-[var(--accent)]">{tag}</span>
		</h1>
		<p class="text-center text-slate-500 dark:text-slate-400 mb-12">{posts.length} 篇文章</p>

		{
			posts.length === 0 ? (
				<p class="text-center text-slate-500 py-20">没有相关文章～</p>
			) : (
				<div class="grid gap-6 md:grid-cols-2">
					{posts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			)
		}

		<div class="text-center mt-12">
			<a href="/blog" class="text-[var(--accent-text)] dark:text-[var(--accent)] hover:underline">← 返回博客</a>
		</div>
	</main>
</BaseLayout>
