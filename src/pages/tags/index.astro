---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../utils/posts';
import { SITE_TITLE } from '../../consts';

const tags = await getAllTags();
---

<BaseLayout title={`标签 - ${SITE_TITLE}`} description="文章标签云">
	<main class="max-w-4xl mx-auto px-4 py-16">
		<div class="mb-12 text-center">
			<span class="eyebrow">Tags</span>
			<h1 class="mt-2 text-4xl font-bold text-slate-800 dark:text-zinc-100">标签</h1>
			<p class="mt-3 text-slate-500 dark:text-zinc-400">共 {tags.length} 个标签</p>
		</div>

		{
			tags.length === 0 ? (
				<p class="text-center text-slate-500 py-20">还没有标签～</p>
			) : (
				<div class="flex flex-wrap justify-center gap-3">
					{tags.map(({ name, count }) => (
						<a
							href={`/tags/${name}/`}
							class="flat-card hover-lift px-6 py-3 text-center group"
						>
							<div class="text-lg font-semibold text-slate-800 group-hover:text-[var(--primary-main)] dark:text-zinc-100 dark:group-hover:text-primary-300 transition-colors">
								{name}
							</div>
							<div class="text-sm text-slate-500 dark:text-zinc-400 mt-1">
								{count} 篇文章
							</div>
						</a>
					))}
				</div>
			)
		}
	</main>
</BaseLayout>
