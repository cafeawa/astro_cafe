---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../utils/posts';
import { SITE_TITLE } from '../../consts';

const tags = await getAllTags();
---

<BaseLayout title={`标签 - ${SITE_TITLE}`} description="文章标签云">
	<main class="max-w-4xl mx-auto px-4 py-16">
		<h1 class="text-4xl font-bold mb-4 text-center">标签</h1>
		<p class="text-center text-gray-500 dark:text-gray-400 mb-12">共 {tags.length} 个标签</p>

		{
			tags.length === 0 ? (
				<p class="text-center text-gray-500 py-20">还没有标签～</p>
			) : (
				<div class="flex flex-wrap justify-center gap-3">
					{tags.map(({ name, count }) => (
						<a
							href={`/tags/${name}/`}
							class="group px-6 py-3 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 hover:shadow-md hover:border-blue-300 dark:hover:border-blue-600 transition-all duration-300 text-center"
						>
							<div class="text-lg font-semibold group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
								{name}
							</div>
							<div class="text-sm text-gray-500 dark:text-gray-400 mt-1">
								{count} 篇文章
							</div>
						</a>
					))}
				</div>
			)
		}
	</main>
</BaseLayout>
