---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getAllTags } from '../../utils/posts';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import PostCard from '../../components/PostCard.astro';

const posts = await getPublishedPosts();
const allTags = await getAllTags();

const selectedTag = Astro.url.searchParams.get('tag') || '';
const filteredPosts = selectedTag
	? posts.filter((post) => post.data.tags.includes(selectedTag))
	: posts;
---

<BaseLayout title={`博客 - ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main class="max-w-5xl mx-auto px-4 py-12">
		<h1 class="text-4xl font-bold mb-4 text-center text-slate-800 dark:text-slate-100">博客</h1>

		{
			allTags.length > 0 && (
				<div class="flex flex-wrap justify-center gap-2 mb-10">
					<a
						href="/blog"
						class={`px-3 py-1 text-sm font-medium transition-colors border ${
							!selectedTag
								? 'bg-[var(--accent)] border-[var(--accent-text)] text-slate-800'
								: 'bg-[var(--accent-light)] dark:bg-[rgba(255,214,186,0.1)] border-[rgba(217,156,113,0.2)] dark:border-white/10 text-slate-600 dark:text-slate-300 hover:bg-[var(--accent-peach)] dark:hover:bg-[rgba(255,214,186,0.15)]'
						}`}
					>
						全部
					</a>
					{allTags.map(({ name, count }) => (
						<a
							href={`/blog?tag=${name}`}
							class={`px-3 py-1 text-sm font-medium transition-colors border ${
								selectedTag === name
									? 'bg-[var(--accent)] border-[var(--accent-text)] text-slate-800'
									: 'bg-[var(--accent-light)] dark:bg-[rgba(255,214,186,0.1)] border-[rgba(217,156,113,0.2)] dark:border-white/10 text-slate-600 dark:text-slate-300 hover:bg-[var(--accent-peach)] dark:hover:bg-[rgba(255,214,186,0.15)]'
							}`}
						>
							{name} ({count})
						</a>
					))}
				</div>
			)
		}

		{
			filteredPosts.length === 0 ? (
				<p class="text-center text-slate-500 dark:text-slate-400 py-20">
					{selectedTag ? `没有找到标签为「${selectedTag}」的文章` : '还没有文章，敬请期待～'}
				</p>
			) : (
				<div class="grid gap-6 md:grid-cols-2">
					{filteredPosts.map((post) => (
						<PostCard post={post} />
					))}
				</div>
			)
		}
	</main>
</BaseLayout>
