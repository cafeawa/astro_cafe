---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getAllTags } from '../../utils/posts';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import PostListItem from '../../components/PostListItem.astro';

const posts = await getPublishedPosts();
const allTags = await getAllTags();

const selectedTag = Astro.url.searchParams.get('tag') || '';
const filteredPosts = selectedTag
	? posts.filter((post) => post.data.tags.includes(selectedTag))
	: posts;
---

<BaseLayout title={`博客 - ${SITE_TITLE}`} description={SITE_DESCRIPTION}>
	<main class="max-w-4xl mx-auto px-4 py-12">
		<h1 class="text-4xl font-bold mb-4 text-center text-slate-800 dark:text-zinc-100">博客</h1>

		{
			allTags.length > 0 && (
				<div class="flex flex-wrap justify-center gap-2 mb-10">
					<a
						href="/blog"
						class={`px-3 py-1 text-sm font-medium rounded-full border transition-colors ${
							!selectedTag
								? 'bg-primary/10 border-primary/30 text-[var(--primary-main)]'
								: 'border-slate-200 bg-white/50 text-slate-600 hover:bg-primary/5 dark:border-zinc-800 dark:bg-zinc-900/50 dark:text-zinc-300 dark:hover:bg-primary/5'
						}`}
					>
						全部
					</a>
					{allTags.map(({ name, count }) => (
						<a
							href={`/blog?tag=${name}`}
							class={`px-3 py-1 text-sm font-medium rounded-full border transition-colors ${
								selectedTag === name
									? 'bg-primary/10 border-primary/30 text-[var(--primary-main)]'
									: 'border-slate-200 bg-white/50 text-slate-600 hover:bg-primary/5 dark:border-zinc-800 dark:bg-zinc-900/50 dark:text-zinc-300 dark:hover:bg-primary/5'
							}`}
						>
							{name} ({count})
						</a>
					))}
				</div>
			)
		}

		{
			filteredPosts.length === 0 ? (
				<p class="text-center text-slate-500 dark:text-zinc-400 py-20">
					{selectedTag ? `没有找到标签为「${selectedTag}」的文章` : '还没有文章，敬请期待～'}
				</p>
			) : (
				<div class="flex flex-col gap-4">
					{filteredPosts.map((post) => (
						<PostListItem post={post} />
					))}
				</div>
			)
		}
	</main>
</BaseLayout>
