---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRecentPosts } from '../utils/posts';
import { SITE_TITLE, SITE_DESCRIPTION, HERO } from '../consts';

const recentPosts = await getRecentPosts(3);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<main class="max-w-4xl mx-auto px-4 py-16">
		<!-- Hero -->
		<section class="text-center mb-20">
			<h1 class="text-5xl font-bold mb-4 tracking-tight">{HERO.greeting}</h1>
			<p class="text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">{HERO.subtitle}</p>
			<div class="mt-8 flex justify-center gap-4">
				<a href="/blog" class="inline-block px-6 py-3 bg-blue-600 text-white rounded-full font-medium hover:bg-blue-700 transition-colors">
					浏览文章
				</a>
				<a href="/about" class="inline-block px-6 py-3 border border-gray-300 dark:border-gray-600 rounded-full font-medium hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">
					关于我
				</a>
			</div>
		</section>

		<!-- 最新文章 -->
		{
			recentPosts.length > 0 && (
				<section>
					<h2 class="text-2xl font-bold mb-8 text-center">最新文章</h2>
					<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
						{recentPosts.map((post) => (
							<a
								href={`/blog/${post.id}/`}
								class="group block p-6 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 hover:shadow-md hover:border-blue-300 dark:hover:border-blue-600 transition-all duration-300"
							>
								<h3 class="text-lg font-semibold mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
									{post.data.title}
								</h3>
								<p class="text-sm text-gray-500 dark:text-gray-400 mb-3">
									{post.data.pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}
								</p>
								<p class="text-gray-600 dark:text-gray-300 text-sm line-clamp-3">
									{post.data.description}
								</p>
							</a>
						))}
					</div>
					<div class="text-center mt-10">
						<a href="/blog" class="text-blue-600 dark:text-blue-400 hover:underline font-medium">
							查看全部文章 →
						</a>
					</div>
				</section>
			)
		}
	</main>
</BaseLayout>
