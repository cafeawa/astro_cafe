---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRecentPosts, getPublishedPosts, getAllTags } from '../utils/posts';
import { SITE_TITLE, SITE_DESCRIPTION, HERO, SITE_AUTHOR, SOCIAL_LINKS } from '../consts';
import PostListItem from '../components/PostListItem.astro';
import heroImage from '../assets/hero-arona.webp';
import avatarImage from '../assets/author-avatar.png';

const recentPosts = await getRecentPosts(4);
const allPosts = await getPublishedPosts();
const allTags = await getAllTags();

const statPosts = allPosts.length;
const statTags = allTags.length;
const statYears = new Set(allPosts.map((p) => p.data.pubDate.getFullYear())).size;

// 热门标签：已按数量降序，取前 6
const hotTags = allTags.slice(0, 6);

// 社交图标（填充式）
const socialIcons: Record<string, string> = {
	github:
		'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
};
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>

	<div class="hero-shell">
		<!-- 首屏背景图。宽屏时绝对定位铺到页面最顶端（钻到固定顶栏的毛玻璃后面），
		     窄屏退化成普通块级图，文案跟到图片下方。 -->
		<div class="hero-band" aria-hidden="true">
			<Image
				class="hero-band-img"
				src={heroImage}
				alt=""
				widths={[768, 1152, 1536, 1919]}
				sizes="100vw"
				loading="eager"
				fetchpriority="high"
			/>
			<div class="hero-band-fade"></div>
		</div>

		<main class="relative max-w-7xl mx-auto px-4 py-10">

			<!-- Hero 文案：宽屏压在右侧星空区，窄屏排在图片下方 -->
			<section class="hero-copy mb-10">
				<span class="eyebrow hero-eyebrow">Welcome</span>
				<h1 class="hero-title">{HERO.greeting}</h1>
				<p class="hero-subtitle">{HERO.subtitle}</p>
				<div class="hero-actions">
					<a href="/blog" class="btn-primary">浏览文章</a>
					<a href="/about" class="btn-hero-ghost">关于我</a>
				</div>
			</section>

			<div class="flex gap-8">
				<!-- 中栏：主内容 -->
				<div class="flex-1 min-w-0">
				<!-- 最新文章：列表样式 -->
				{
					recentPosts.length > 0 && (
						<section>
							<div class="flex justify-between items-end mb-5 px-1">
								<div>
									<span class="eyebrow">Latest</span>
									<h2 class="section-title mt-1.5 text-xl font-bold text-slate-800 dark:text-zinc-100">
										最新文章
									</h2>
								</div>
								<a
									href="/blog"
									class="relative group inline-block text-sm font-medium text-[var(--primary-main)] dark:text-primary-300 hover:text-primary-500 dark:hover:text-primary-200 transition-colors"
								>
									查看全部 →
									<span class="absolute bottom-0 left-0 w-0 h-[2px] bg-[var(--primary-main)] transition-all duration-200 group-hover:w-full"></span>
								</a>
							</div>

							<div class="flex flex-col gap-4">
								{recentPosts.map((post) => (
									<PostListItem post={post} />
								))}
							</div>
						</section>
					)
				}
			</div>

			<!-- 右栏：热门标签 / 统计 / 关于 -->
			<aside class="hidden lg:block w-72 shrink-0">
				<div class="sticky top-20 space-y-6">
					{
						hotTags.length > 0 && (
							<section class="flat-card overflow-hidden">
								<div class="px-4 pt-4 pb-2">
									<span class="eyebrow">Tags</span>
									<h2 class="mt-1.5 font-bold text-slate-800 dark:text-zinc-100">热门标签</h2>
								</div>
								<ul class="pb-2">
									{hotTags.map(({ name, count }) => (
										<li>
											<a href={`/tags/${name}/`} class="flex items-center gap-2.5 px-4 py-2.5 transition-colors hover:bg-primary-50/70 dark:hover:bg-primary-900/15">
												<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="size-3.5 shrink-0 text-slate-500 dark:text-zinc-400">
													<path d="M3 3h8l8 8-8 8-8-8z" />
												</svg>
												<span class="min-w-0 flex-1 truncate text-[13px] font-medium text-slate-700 dark:text-zinc-200">{name}</span>
												<span class="shrink-0 rounded bg-primary-100 px-1.5 py-px text-[11px] font-semibold text-primary-700 dark:bg-primary-900/40 dark:text-primary-300">{count}</span>
											</a>
										</li>
									))}
								</ul>
							</section>
						)
					}

					<section class="card-inset grid grid-cols-3 divide-x divide-slate-200/80 dark:divide-zinc-800 p-4">
						<div class="text-center">
							<div class="text-2xl font-bold tabular-nums text-[var(--primary-main)] dark:text-primary-300">{statPosts}</div>
							<div class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">文章</div>
						</div>
						<div class="text-center">
							<div class="text-2xl font-bold tabular-nums text-[var(--primary-main)] dark:text-primary-300">{statTags}</div>
							<div class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">标签</div>
						</div>
						<div class="text-center">
							<div class="text-2xl font-bold tabular-nums text-[var(--primary-main)] dark:text-primary-300">{statYears}</div>
							<div class="text-xs text-slate-500 dark:text-zinc-400 mt-0.5">年份</div>
						</div>
					</section>

					<section class="flat-card p-5">
						<div class="flex items-center gap-3">
							<div class="author-avatar size-11 shrink-0 rounded-full">
								<Image src={avatarImage} alt={`${SITE_AUTHOR} 的头像`} width={88} height={88} />
							</div>
							<div class="min-w-0">
								<div class="font-semibold text-slate-800 dark:text-zinc-100">{SITE_AUTHOR}</div>
								<div class="text-xs text-slate-500 dark:text-zinc-400">记录技术、生活</div>
							</div>
						</div>
						<div class="mt-4 flex items-center justify-between">
							<a href="/about" class="text-sm font-medium text-[var(--primary-main)] dark:text-primary-300 hover:underline">关于我 →</a>
							<div class="flex items-center gap-1">
								{SOCIAL_LINKS.map((item) => (
									<a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.name} class="grid size-8 place-items-center rounded-full text-slate-500 transition-colors hover:bg-slate-100 hover:text-[var(--primary-main)] dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-primary-300">
										<svg viewBox="0 0 24 24" fill="currentColor" class="size-4"><path d={socialIcons[item.icon] || socialIcons.github} /></svg>
									</a>
								))}
							</div>
						</div>
					</section>
				</div>
			</aside>
		</div>
		</main>
	</div>
</BaseLayout>

<style>
	.author-avatar {
		position: relative;
		overflow: hidden;
		background: #e7e3d8;
	}

	.author-avatar :global(img) {
		position: absolute;
		left: -100%;
		top: -20%;
		width: 200%;
		height: 200%;
		max-width: none;
		object-fit: cover;
	}

	/* ===== 首屏背景图 =====
	   窄屏（默认）：图是一块普通横幅，文案排在它下面，跟随主题色。
	   宽屏（≥1280px）：图脱离文档流铺满首屏、顶到页面最上沿，
	   文案被推到右侧那片没有细节的星空上，用固定浅色（不跟主题，因为底下永远是深蓝）。
	   选 1280px 作为切换点：更窄时右侧留给文案的宽度会压到人物脸上。 */
	.hero-shell {
		position: relative;
	}

	.hero-band {
		position: relative;
		overflow: hidden;
		background-color: #0b1523; /* 图片解码前的兜底，避免闪白 */
	}

	.hero-band-img {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		object-position: 14% 30%; /* 保住阿罗娜的头和光环 */
	}

	.hero-band-fade {
		display: none;
	}

	/* 窄屏：文案在图片下方，用常规主题色 */
	.hero-copy {
		--hero-fg: #1e293b; /* slate-800 */
		--hero-fg-muted: #64748b; /* slate-500 */
		--hero-accent: var(--primary-700);
		padding-top: 0.5rem;
	}

	:global(.dark) .hero-copy {
		--hero-fg: var(--text-strong);
		--hero-fg-muted: var(--color-zinc-400);
		--hero-accent: var(--primary-300);
	}

	.hero-title {
		margin: 0.5rem 0 0.75rem;
		font-size: 1.875rem;
		line-height: 1.25;
		font-weight: 700;
		letter-spacing: -0.015em;
		color: var(--hero-fg);
	}

	.hero-subtitle {
		margin-bottom: 1.5rem;
		font-size: 1.0625rem;
		color: var(--hero-fg-muted);
	}

	.hero-eyebrow {
		color: var(--hero-accent);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	/* 与 .btn-ghost 同形，但颜色跟着 --hero-fg 走（压在图上时要是浅色） */
	.btn-hero-ghost {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: 9999px;
		padding: 0.5rem 1.375rem;
		border: 1px solid color-mix(in srgb, var(--hero-fg) 34%, transparent);
		color: var(--hero-fg);
		font-weight: 500;
		background-color: transparent;
		transition: background-color 0.2s ease, border-color 0.2s ease;
	}

	.btn-hero-ghost:hover {
		background-color: color-mix(in srgb, var(--hero-fg) 14%, transparent);
		border-color: color-mix(in srgb, var(--hero-fg) 52%, transparent);
	}

	@media (min-width: 1280px) {
		/* 图上文字统一浅色 —— 图片是深蓝的，浅色模式下也不能用深色字 */
		.hero-copy,
		:global(.dark) .hero-copy {
			--hero-fg: #ffffff;
			--hero-fg-muted: rgb(255 255 255 / 0.76);
			--hero-accent: var(--primary-200);
			display: flex;
			flex-direction: column;
			align-items: flex-start;
			justify-content: center;
			margin-left: auto;
			min-height: 30rem; /* 撑开首屏，让下面的正文从图片下面开始 */
			max-width: 26rem;
			padding: 0;
			text-align: left;
			text-shadow: 0 1px 14px rgb(6 16 38 / 0.55);
		}

		.hero-title {
			font-size: 2.25rem;
		}

		.hero-band {
			position: absolute;
			inset: -4rem 0 auto 0; /* -4rem 抵消 body 的 pt-16，顶到 y=0 */
			height: 38rem;
		}

		.hero-band-img {
			height: 100%;
			aspect-ratio: auto;
			object-position: left center;
		}

		/* 图片底边只留渐变，不压任何线：两套主题都靠 --hero-fade 融进页面底色 */

		/* 图片底边渐变到页面底色。两套主题都做，否则一套是渐变收口、一套是硬边，
		   观感对不上。浅色模式要更高：深蓝往近白过渡对比比深色模式强，
		   层高不够会看出色阶断层。 */
		.hero-band-fade {
			display: block;
			position: absolute;
			inset: auto 0 0 0;
			height: 34%;
			background: linear-gradient(to bottom, transparent, var(--hero-fade));
		}

		:global(.dark) .hero-band-fade {
			height: 28%;
		}
	}
</style>
