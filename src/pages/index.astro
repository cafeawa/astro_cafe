---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRecentPosts, getPublishedPosts, getAllTags } from '../utils/posts';
import { SITE_TITLE, SITE_DESCRIPTION, HERO, SITE_AUTHOR, SOCIAL_LINKS } from '../consts';
import PostCard from '../components/PostCard.astro';

const recentPosts = await getRecentPosts(3);
const allPosts = await getPublishedPosts();
const allTags = await getAllTags();

const statPosts = allPosts.length;
const statTags = allTags.length;
const statYears = new Set(allPosts.map((p) => p.data.pubDate.getFullYear())).size;

// 热门标签：getAllTags 已按数量降序，取前 8
const hotTags = allTags.slice(0, 8);

const avatarInitial = SITE_AUTHOR.charAt(0).toUpperCase();

// 社交图标 SVG path（按需扩展）
const socialIcons: Record<string, string> = {
	github:
		'M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12',
};
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>

	<main class="max-w-5xl mx-auto px-4 py-12 md:py-20 flex flex-col gap-16 relative z-10">

		<!-- Hero 区：毛玻璃 + 头像 + 问候 + 介绍 + CTA + 社交图标 -->
		<section class="flat-card p-10 md:p-16 text-center relative overflow-hidden">
			<div class="relative z-10 flex flex-col items-center">
				<div class="mb-5 grid size-20 place-items-center rounded-full bg-gradient-to-br from-primary-200 via-primary-300 to-primary-400 text-3xl font-bold text-[var(--primary-700)] shadow-lg dark:from-primary-500/30 dark:via-primary-400/30 dark:to-primary-300/30 dark:text-primary-200">
					{avatarInitial}
				</div>
				<h1 class="text-4xl md:text-5xl font-bold mb-4 tracking-tight text-slate-800 dark:text-zinc-100">
					{HERO.greeting}
				</h1>
				<p class="text-lg md:text-xl text-slate-500 dark:text-zinc-400 max-w-2xl mx-auto mb-8">
					{HERO.subtitle}
				</p>
				<div class="flex flex-wrap justify-center gap-4 mb-8">
					<a href="/blog" class="btn-primary inline-block">浏览文章</a>
					<a href="/about" class="btn-ghost inline-block">关于我</a>
				</div>
				{
					SOCIAL_LINKS.length > 0 && (
						<div class="flex items-center gap-2">
							{SOCIAL_LINKS.map((item) => (
								<a
									href={item.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={item.name}
									class="grid size-9 place-items-center rounded-full border border-slate-200 text-slate-500 transition-colors hover:bg-primary/5 hover:text-[var(--primary-main)] hover:border-primary-300 dark:border-zinc-800 dark:text-zinc-400 dark:hover:bg-primary/5 dark:hover:text-primary-300"
								>
									<svg viewBox="0 0 24 24" fill="currentColor" class="size-4">
										<path d={socialIcons[item.icon] || socialIcons.github} />
									</svg>
								</a>
							))}
						</div>
					)
				}
			</div>
		</section>

		<!-- 数据小统计 -->
		<section class="flat-card p-6 grid grid-cols-3 divide-x divide-slate-200 dark:divide-zinc-800">
			<div class="text-center">
				<div class="text-2xl font-bold text-slate-800 dark:text-zinc-100">{statPosts}</div>
				<div class="text-sm text-slate-500 dark:text-zinc-400 mt-1">篇文章</div>
			</div>
			<div class="text-center">
				<div class="text-2xl font-bold text-slate-800 dark:text-zinc-100">{statTags}</div>
				<div class="text-sm text-slate-500 dark:text-zinc-400 mt-1">个标签</div>
			</div>
			<div class="text-center">
				<div class="text-2xl font-bold text-slate-800 dark:text-zinc-100">{statYears}</div>
				<div class="text-sm text-slate-500 dark:text-zinc-400 mt-1">个年份</div>
			</div>
		</section>

		<!-- 热门标签胶囊云 -->
		{
			hotTags.length > 0 && (
				<section>
					<div class="flex justify-between items-end mb-6 px-2">
						<h2 class="text-2xl font-bold text-slate-800 dark:text-zinc-100">热门标签</h2>
						<a
							href="/tags"
							class="relative group inline-block text-sm font-medium text-[var(--primary-main)] dark:text-primary-300 hover:text-primary-500 dark:hover:text-primary-200 transition-colors"
						>
							全部标签 →
							<span class="absolute bottom-0 left-0 w-0 h-[2px] bg-[var(--primary-main)] transition-all duration-200 group-hover:w-full"></span>
						</a>
					</div>
					<div class="flex flex-wrap gap-2">
						{hotTags.map(({ name, count }) => (
							<a
								href={`/tags/${name}/`}
								class="rounded-full bg-primary/10 px-3.5 py-1.5 text-sm font-medium text-[var(--primary-main)] transition-colors hover:bg-primary/20 dark:bg-primary-500/15 dark:text-primary-300 dark:hover:bg-primary-500/25"
							>
								{name}
								<span class="ml-1 text-xs opacity-70">{count}</span>
							</a>
						))}
					</div>
				</section>
			)
		}

		<!-- 最新文章 -->
		{
			recentPosts.length > 0 && (
				<section>
					<div class="flex justify-between items-end mb-6 px-2">
						<h2 class="text-2xl font-bold text-slate-800 dark:text-zinc-100">最新文章</h2>
						<a
							href="/blog"
							class="relative group inline-block text-sm font-medium text-[var(--primary-main)] dark:text-primary-300 hover:text-primary-500 dark:hover:text-primary-200 transition-colors"
						>
							查看全部 →
							<span class="absolute bottom-0 left-0 w-0 h-[2px] bg-[var(--primary-main)] transition-all duration-200 group-hover:w-full"></span>
						</a>
					</div>

					<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
						{recentPosts.map((post) => (
							<PostCard post={post} />
						))}
					</div>
				</section>
			)
		}
	</main>
</BaseLayout>
