---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPostsByYear } from '../utils/posts';
import { SITE_TITLE } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';

const postsByYear = await getPostsByYear();
const totalPosts = postsByYear.reduce((sum, entry) => sum + entry[1].length, 0);
---

<BaseLayout title={`归档 - ${SITE_TITLE}`} description="文章归档">
	<main class="max-w-3xl mx-auto px-4 py-16">
		<div class="mb-14 text-center">
			<span class="eyebrow">Archive</span>
			<h1 class="mt-2 text-4xl font-bold text-slate-800 dark:text-zinc-100">归档</h1>
			{
				totalPosts > 0 && (
					<p class="mt-3 text-sm tabular-nums text-slate-500 dark:text-zinc-400">
						共 {totalPosts} 篇 · {postsByYear.length} 个年份
					</p>
				)
			}
		</div>

		{
			postsByYear.length === 0 ? (
				<p class="text-center text-slate-500 dark:text-zinc-400 py-20">还没有文章～</p>
			) : (
				<div class="space-y-14">
					{postsByYear.map(([year, posts]) => (
						<section class="relative">
							{/* 年份：大号幽灵数字 + 渐变细线，给整页一个视觉锚点 */}
							<div class="mb-5 flex items-center gap-3">
								<span class="text-5xl font-black leading-none tracking-tight tabular-nums text-primary-300 dark:text-primary-500/35">
									{year}
								</span>
								<span class="rounded-full bg-primary-50 px-2 py-0.5 text-[11px] font-semibold tabular-nums text-primary-700 dark:bg-primary-900/35 dark:text-primary-300">
									{posts.length} 篇
								</span>
								<span class="h-px flex-1 bg-gradient-to-r from-primary-200 to-transparent dark:from-primary-900/70" />
							</div>

							<ol class="relative border-l border-slate-200 dark:border-zinc-800">
								{posts.map((post) => (
									<li class="relative">
										<a
											href={`/blog/${post.id}/`}
											class="group -ml-px flex items-center gap-4 rounded-r-lg border-l-2 border-transparent px-4 py-2.5 transition-all duration-200 hover:border-[var(--primary-main)] hover:bg-white/70 dark:hover:bg-zinc-900/50"
										>
											{/* 时间轴节点 */}
											<span class="absolute left-[-5px] size-2 rounded-full bg-slate-300 transition-all duration-200 group-hover:scale-125 group-hover:bg-[var(--primary-main)] dark:bg-zinc-600" />
											<time class="w-28 shrink-0 text-xs tabular-nums text-slate-400 dark:text-zinc-500">
												<FormattedDate date={post.data.pubDate} />
											</time>
											<span class="relative inline text-[15px] font-medium text-slate-800 transition-colors group-hover:text-[var(--primary-main)] dark:text-zinc-100 dark:group-hover:text-primary-300">
												{post.data.title}
												<span class="absolute bottom-0 left-0 h-[2px] w-0 bg-[var(--primary-main)] transition-all duration-200 group-hover:w-full" />
											</span>
										</a>
									</li>
								))}
							</ol>
						</section>
					))}
				</div>
			)
		}
	</main>
</BaseLayout>
