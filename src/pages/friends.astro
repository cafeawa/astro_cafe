---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';

const friends = [
	// { name: '示例博客', url: 'https://example.com', description: '这是一个示例' },
];
---

<BaseLayout title={`友链 - ${SITE_TITLE}`} description="友情链接">
	<main class="max-w-3xl mx-auto px-4 py-16">
		<h1 class="text-4xl font-bold mb-4 text-center text-slate-800 dark:text-slate-100">友链</h1>
		<p class="text-center text-slate-500 dark:text-slate-400 mb-12">志同道合的朋友们</p>

		{
			friends.length === 0 ? (
				<div class="text-center py-16">
					<p class="text-slate-500 dark:text-slate-400 mb-4">还没有友链～</p>
					<p class="text-slate-400 dark:text-slate-500 text-sm">想要交换友链？欢迎在评论区留言 👋</p>
				</div>
			) : (
				<div class="grid gap-4 sm:grid-cols-2">
					{friends.map((friend) => (
						<a
							href={friend.url}
							target="_blank"
							rel="noopener noreferrer"
							class="flat-card p-5 group"
						>
							<div class="font-semibold text-slate-800 dark:text-slate-100 mb-1 group-hover:text-[var(--accent-text)] transition-colors">{friend.name}</div>
							<div class="text-sm text-slate-500 dark:text-slate-400">{friend.description}</div>
						</a>
					))}
				</div>
			)
		}
	</main>
</BaseLayout>
