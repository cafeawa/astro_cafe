---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`搜索 - ${SITE_TITLE}`} description="站内搜索">
	<main class="max-w-3xl mx-auto px-4 py-16">
		<h1 class="text-4xl font-bold mb-8 text-center text-slate-800 dark:text-slate-100">搜索</h1>

		<input
			id="search-input"
			type="text"
			placeholder="输入关键词搜索文章..."
			autocomplete="off"
			class="w-full px-6 py-4 text-lg border border-[rgba(217,156,113,0.2)] dark:border-white/10 bg-white dark:bg-[#2a2420] focus:outline-none focus:ring-2 focus:ring-[var(--accent-text)] focus:border-transparent transition-shadow mb-10"
		/>

		<div id="search-results" class="space-y-4">
			<p class="text-center text-slate-500 dark:text-slate-400 py-12">搜索索引加载中...</p>
		</div>
	</main>
</BaseLayout>

<script is:inline>
	(function () {
		var input = document.getElementById('search-input');
		var results = document.getElementById('search-results');
		if (!input || !results) return;

		var debounceTimer;

		function renderMessage(msg) {
			results.innerHTML =
				'<p class="text-center text-slate-500 dark:text-slate-400 py-12">' + msg + '</p>';
		}

		async function runSearch() {
			var query = input.value.trim();
			if (!query) {
				renderMessage('输入关键词开始搜索');
				return;
			}
			if (!window._pfSearch) return; // 索引仍在加载，就绪后会自动重跑

			try {
				var searchResult = await window._pfSearch(query);
				if (!searchResult || !searchResult.results.length) {
					renderMessage('没有找到相关文章 😿');
					return;
				}
				// 并行加载前 10 条结果数据（避免逐条 await 的串行延迟）
				var items = await Promise.all(
					searchResult.results.slice(0, 10).map(async function (r) {
						var data = await r.data();
						return {
							url: data.url,
							title: (data.meta && data.meta.title) || data.url,
							excerpt: data.excerpt || '',
						};
					})
				);
				results.innerHTML = items.map(function (item) {
					return '<a href="' + item.url + '" class="flat-card block p-6 group">' +
						'<h3 class="relative inline text-lg font-semibold mb-2 text-[var(--accent-text)] dark:text-[var(--accent)]">' + item.title +
						'<span class="absolute bottom-0 left-0 w-0 h-[2px] bg-[var(--accent-text)] transition-all duration-200 group-hover:w-full"></span></h3>' +
						'<p class="text-sm text-slate-500 dark:text-slate-400">' + item.excerpt + '</p></a>';
				}).join('');
			} catch (e) {
				renderMessage('搜索出错，请稍后再试');
			}
		}

		// 加载 Pagefind（文件含 export，必须 module 模式）。
		// 用 dynamic import + try/catch 捕获 404：静态 import 失败只抛到 window，
		// 不会触发 script 元素的 onerror，所以改用自定义事件把状态回传给外层。
		var loader = document.createElement('script');
		loader.type = 'module';
		loader.textContent = [
			'try {',
			'  const { search } = await import("/pagefind/pagefind.js");',
			'  window._pfSearch = search;',
			'  window.dispatchEvent(new Event("pagefind:ready"));',
			'} catch (e) {',
			'  window.dispatchEvent(new Event("pagefind:error"));',
			'}',
		].join('\n');
		document.head.appendChild(loader);

		window.addEventListener('pagefind:ready', function () {
			// 就绪时若输入框已有内容则立即搜索，修复加载前抢先输入被静默丢弃的竞态
			if (input.value.trim()) runSearch();
			else renderMessage('输入关键词开始搜索');
		});
		window.addEventListener('pagefind:error', function () {
			renderMessage('搜索索引未生成，请运行 <code>npm run build</code>');
		});

		input.addEventListener('input', function () {
			clearTimeout(debounceTimer);
			debounceTimer = setTimeout(runSearch, 300);
		});
	})();
</script>
