---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../consts';
---

<BaseLayout title={`搜索 - ${SITE_TITLE}`} description="站内搜索">
	<main data-search-auto-open class="max-w-3xl mx-auto px-4 py-16 text-center">
		<h1 class="text-4xl font-bold mb-8 text-slate-800 dark:text-zinc-100">搜索文章</h1>
		<button type="button" data-search-trigger aria-controls="search-input" class="btn-primary">打开搜索框</button>
	</main>
</BaseLayout>
